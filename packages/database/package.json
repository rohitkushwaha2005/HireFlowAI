{
  "name": "@hireflow/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "dotenv -e ../../.env -- prisma generate",
    "migrate:dev": "dotenv -e ../../.env -- prisma migrate deploy",
    "migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "reset": "dotenv -e ../../.env -- prisma migrate reset --force",
    "seed": "dotenv -e ../../.env -- tsx src/seed/index.ts",
    "studio": "dotenv -e ../../.env -- prisma studio",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "postinstall": "prisma generate",
    "migrate:new": "dotenv -e ../../.env -- node scripts/new-migration.mjs"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "tsx src/seed/index.ts"
  },
  "dependencies": {
    "@hireflow/shared": "workspace:*",
    "@prisma/client": "^6.19.0"
  },
  "devDependencies": {
    "@hireflow/config": "workspace:*",
    "@node-rs/argon2": "^2.0.2",
    "dotenv": "^17.2.0",
    "prisma": "^6.19.0",
    "tsx": "^4.20.0",
    "dotenv-cli": "^10.0.0"
  }
}
