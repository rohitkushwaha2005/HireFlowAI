# ─────────────────────────────────────────────────────────────────────────────
# HireFlow AI — environment variables
# Copy to `.env` (never commit `.env`). Values below are development defaults that
# match docker-compose.yml. Replace every secret in production.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
LOG_LEVEL=info

# ── URLs ─────────────────────────────────────────────────────────────────────
API_PORT=4000
# Public origin of the web app (CORS allow-list, links in emails, OAuth redirects)
WEB_URL=http://localhost:5173
# Public origin of the API (OAuth callback)
API_URL=http://localhost:4000

# ── Data stores ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://hireflow:hireflow@localhost:5432/hireflow?schema=public
# Used by integration tests only
TEST_DATABASE_URL=postgresql://hireflow:hireflow@localhost:5432/hireflow_test?schema=public
REDIS_URL=redis://localhost:6379

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=14
# Set true behind HTTPS
COOKIE_SECURE=false

# Google OAuth (optional — button is hidden when unset)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── AI ───────────────────────────────────────────────────────────────────────
# anthropic | heuristic | auto  (auto = anthropic when AI_API_KEY is set, otherwise heuristic)
AI_PROVIDER=auto
# Anthropic API key (Claude). Required for production-quality AI.
AI_API_KEY=
AI_MODEL=claude-opus-5
# local (bge-small-en-v1.5 via ONNX, 384 dims)
EMBEDDING_PROVIDER=local
# Where downloaded embedding model weights are cached
EMBEDDING_CACHE_DIR=.cache/models

# ── Object storage (S3-compatible; MinIO in development) ─────────────────────
# s3 | local
STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=hireflow
S3_SECRET_KEY=hireflow-secret
S3_BUCKET=hireflow-resumes
S3_FORCE_PATH_STYLE=true
# Used when STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.storage

# ── Email ────────────────────────────────────────────────────────────────────
# smtp | resend | console
EMAIL_PROVIDER=smtp
EMAIL_FROM="HireFlow AI <no-reply@hireflow.local>"
# Resend API key (EMAIL_PROVIDER=resend)
EMAIL_API_KEY=
SMTP_HOST=localhost
SMTP_PORT=1025

# ── Queue ────────────────────────────────────────────────────────────────────
# bullmq | inline  (inline runs jobs synchronously in-process; used by tests)
QUEUE_DRIVER=bullmq
WORKER_CONCURRENCY=4

# ── Uploads ──────────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=5

# ── Web (Vite) ───────────────────────────────────────────────────────────────
# Leave empty to use the Vite dev proxy (/api → API_URL)
VITE_API_URL=
