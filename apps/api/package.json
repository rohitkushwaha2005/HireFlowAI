{
  "name": "@hireflow/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch --clear-screen=false src/server.ts",
    "dev:worker": "dotenv -e ../../.env -- tsx watch --clear-screen=false src/worker.ts",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:unit": "vitest run --project unit",
    "test:integration": "dotenv -e ../../.env -- vitest run --project integration",
    "backfill": "dotenv -e ../../.env -- tsx src/scripts/backfill.ts",
    "seed": "dotenv -e ../../.env -- tsx src/scripts/seed.ts",
    "dev:all": "concurrently -n api,worker -c blue,magenta \"pnpm dev\" \"pnpm dev:worker\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@aws-sdk/client-s3": "^3.1141.0",
    "@hireflow/database": "workspace:^",
    "@hireflow/shared": "workspace:^",
    "@huggingface/transformers": "^4.3.0",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^6.19",
    "bullmq": "^6.3.9",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.10",
    "pdf-lib": "^1.17.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prisma": "^6.19",
    "rate-limit-redis": "^6.0.1",
    "swagger-ui-express": "^5.0.1",
    "undici": "^7",
    "unpdf": "^1.8.1",
    "zod": "^4.1"
  },
  "devDependencies": {
    "@hireflow/config": "workspace:^",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^22",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "concurrently": "^10.0.5",
    "dotenv-cli": "^10.0.0",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.3.0",
    "tsup": "^8.5.1",
    "tsx": "^4.20.0",
    "vitest": "^3.2"
  }
}
